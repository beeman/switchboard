# Copy to .env for the first Instance.
# A second Instance uses another file and another Compose project name.
# Do not commit the copy. Do not put a real hostname in git.

COMPOSE_PROJECT_NAME=switchboard

VOICE_WS_PORT=8000
VOICE_HTTP_PORT=8003
SPEECH_PORT=8880
CLIENT_PORT=8006

# URL every Client and Device of this Instance can open.
WEBSOCKET_URL=ws://<host>:8000/xiaozhi/v1/
VISION_URL=http://<host>:8003/mcp/vision/explain

# URL the browser that loads the Client can open. A Device may use a different one.
OTA_URL=http://<host>:8003/xiaozhi/ota/

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3
SPEECH_URL=http://speech:8880/v1/audio/speech

# Directory that contains SenseVoiceSmall/model.pt. Shared read-only across Instances.
MODELS_DIR=./models

# Console profile. Leave SWITCHBOARD_CONSOLE at 0 to keep module settings in the rendered file.
# To use the console: set SWITCHBOARD_CONSOLE=1, point OTA_URL at the console, and run
# docker compose --profile console up
SWITCHBOARD_CONSOLE=0
CONSOLE_PORT=8002
MANAGER_URL=http://console:8002/xiaozhi
# Reaches only the Compose network. MySQL and Redis are not published on the host.
MYSQL_ROOT_PASSWORD=switchboard
